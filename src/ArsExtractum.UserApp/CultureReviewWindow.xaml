<Window x:Class="ArsExtractum.UserApp.CultureReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conferência de culturas" Width="980" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="12" Background="{StaticResource WarningBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="5">
            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
        <TextBox x:Name="ReviewBox" Grid.Row="1" Margin="0,12"
                 Text="{Binding ReviewText}" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                    Click="Copy_Click" Content="Copiar conferência" />
            <Button Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="Close_Click" Content="Fechar" />
        </StackPanel>
    </Grid>
</Window>
