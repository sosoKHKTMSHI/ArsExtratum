<Window x:Class="ArsExtractum.UserApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ars Extractum — Extrator Laboratorial"
        Width="1500" Height="860" MinWidth="1120" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">
    <Grid Margin="24,18,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontFamily="Georgia" FontSize="29" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}" Text="ARS EXTRACTUM" />
                <TextBlock Margin="1,2,0,0" FontSize="13" Foreground="{StaticResource MutedInkBrush}"
                           Text="Extrator laboratorial" />
            </StackPanel>
            <Button x:Name="AboutButton" Grid.Column="1" VerticalAlignment="Top"
                    Style="{StaticResource SecondaryButton}" Click="About_Click" Content="Sobre" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DropPanel" Padding="18,12" Style="{StaticResource PanelBorder}"
                    BorderBrush="#8A8A8A" BorderThickness="1.5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" Text="Arraste e solte PDFs aqui" />
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}"
                               Text="ou" />
                    <Button x:Name="AddPdfButton" Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding IsIdle}" Click="AddPdf_Click" Content="Adicionar PDFs" />
                </StackPanel>
            </Border>
            <Button x:Name="ProcessButton" Grid.Column="1" Margin="14,0,0,0" MinWidth="150"
                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanProcess}"
                    Click="Process_Click" Content="Processar PDFs" />
            <Button x:Name="CancelButton" Grid.Column="2" Margin="8,0,0,0" MinWidth="92"
                    Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsBusy}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="Cancel_Click" Content="Cancelar" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" />
                <ColumnDefinition Width="275" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource PanelBorder}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="PDFs" />
                    <ListBox x:Name="PdfList" Grid.Row="1" Margin="0,12,0,10"
                             ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}" Text="{Binding Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RemovePdfButton" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}"
                                IsEnabled="{Binding CanRemoveDocument}" Click="RemovePdf_Click" Content="Remover" />
                        <Button x:Name="ClearSessionButton" Grid.Column="1" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanClearSession}"
                                Click="ClearSession_Click" Content="Limpar sessão" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource PanelBorder}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Pacientes" />
                    <ListBox x:Name="PatientList" Grid.Row="1" Margin="0,12,0,0"
                             ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,7">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0" FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}" Text="{Binding Summary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Resultado clínico" />
                            <CheckBox x:Name="ShowUnitsCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                      IsEnabled="{Binding IsIdle}" IsChecked="{Binding ShowUnits}" Content="Exibir unidades" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CultureReviewButton" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanReviewCultures}"
                                    Click="ReviewCultures_Click" Content="Conferir culturais" />
                            <Button x:Name="CurvesButton" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanOpenCurves}"
                                    Click="LaboratoryCurves_Click" Content="Curvas laboratoriais" />
                            <Button x:Name="CopyOutputButton" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanCopyOutput}" Click="CopyOutput_Click"
                                    Content="Copiar resultado" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="NoticePanel" Grid.Row="1" Margin="0,12,0,10" MaxHeight="105"
                            Padding="11" Background="{StaticResource WarningBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="5"
                            Visibility="{Binding HasNotices, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Foreground="#5A4300" Text="{Binding NoticeText}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <TextBox x:Name="OutputBox" Grid.Row="2" Padding="12"
                             Text="{Binding OutputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" SpellCheck.IsEnabled="False"
                             FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,11,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Foreground="{StaticResource MutedInkBrush}" Text="{Binding StatusText}" />
                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedInkBrush}"
                           Text="Processamento local. O Ars Extractum não interpreta diagnóstico ou conduta." />
            </StackPanel>
            <ProgressBar Grid.Column="1" Width="220" Height="7" VerticalAlignment="Center"
                         Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
