<Window x:Class="ArsExtractum.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ars Extractum — Inspetor de extração"
        Width="1450"
        Height="780"
        MinWidth="1120"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F6"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="14,12"
                Background="White"
                BorderBrush="#D6DCE0"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Click="AddPdf_Click" Content="Adicionar PDFs" />
                    <Button Click="RemovePdf_Click" Content="Remover" />
                    <Button Click="Clear_Click" Content="Limpar" />
                    <Button Click="Process_Click"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Content="Processar" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Margin="0,0,14,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ShowUnits}"
                              Content="Exibir unidades"
                              ToolTip="Altera somente o texto clínico; unidades permanecem preservadas no JSON" />
                    <CheckBox Margin="0,0,14,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ShowCultures}"
                              Content="Exibir culturas"
                              ToolTip="Desabilitado por padrão; resultados culturais exigem conferência documental" />
                    <Button Margin="0,0,8,0" Click="ReviewCultures_Click"
                            IsEnabled="{Binding HasSelectedPatientCultures}"
                            Content="Conferir culturais" />
                    <Button Click="Copy_Click" Content="Copiar saída" />
                    <Button Margin="0"
                            Click="SaveReport_Click"
                            Content="Baixar outputs ZIP..."
                            ToolTip="Escolha quais etapas serão incluídas em um único pacote de auditoria" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Margin="0,0,6,0" Header="Arquivos PDF" Padding="8">
                <ListBox ItemsSource="{Binding Documents}"
                         SelectedItem="{Binding SelectedDocument}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="#66717A"
                                           Text="{Binding Status}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="280" />
                </Grid.RowDefinitions>

                <GroupBox Header="Pacientes identificados" Padding="8">
                    <ListBox ItemsSource="{Binding Patients}"
                             SelectedItem="{Binding SelectedPatient}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding DisplayName}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="#66717A"
                                               Text="{Binding Summary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Etapas" Padding="8">
                    <ListBox ItemsSource="{Binding Stages}"
                             SelectedItem="{Binding SelectedStage}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Margin="0,2,9,0"
                                              VerticalAlignment="Top"
                                              IsChecked="{Binding IsEnabled}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="#66717A"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Description}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="2"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns" />

            <Border Grid.Column="3"
                    Background="White"
                    BorderBrush="#D6DCE0"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="12,9"
                            Background="#F8F9FA"
                            BorderBrush="#D6DCE0"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding SelectedStage.Name, FallbackValue=Saída}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="#66717A"
                                       Text="{Binding DurationText}" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Margin="8" Padding="8" Background="#FFF4CE" BorderBrush="#D6A500" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedPatientCultures}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CultureWarningText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Border>
                    <TextBox x:Name="OutputBox"
                             Grid.Row="1"
                             Padding="14"
                             BorderThickness="0"
                             Background="White"
                             Foreground="#172026"
                             FontFamily="Consolas"
                             FontSize="13"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             IsReadOnly="True"
                             SpellCheck.IsEnabled="False"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Text="{Binding OutputText, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="14,9"
                Background="#E7ECEF"
                BorderBrush="#CCD4D9"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right"
                             Width="220"
                             Height="7"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                <TextBlock Foreground="#354149" Text="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
