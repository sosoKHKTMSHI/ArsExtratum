<Window x:Class="ArsExtractum.App.CultureReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conferência de culturas e microbiologia"
        Width="980" Height="700" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="10" Background="#FFF4CE" BorderBrush="#D6A500" BorderThickness="1">
            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
        <TextBox x:Name="ReviewBox" Grid.Row="1" Margin="0,10"
                 Text="{Binding ReviewText}" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="Copy_Click" Content="Copiar conferência" />
            <Button Margin="8,0,0,0" IsDefault="True" Click="Close_Click" Content="Fechar" />
        </StackPanel>
    </Grid>
</Window>
