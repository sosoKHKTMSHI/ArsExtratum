<Window x:Class="ArsExtractum.App.LaboratoryCurvesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Curvas laboratoriais"
        Width="1100" Height="720" MinWidth="850" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Curvas laboratoriais" />
            <TextBlock Margin="0,4,0,0" Foreground="#52616B"
                       Text="{Binding PatientDisplayName, StringFormat=Paciente: {0}}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Resultados disponíveis" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="3" IsChecked="{Binding IsSelected}"
                                          Content="{Binding DisplayName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <StackPanel Grid.Column="2">
                <GroupBox Header="Período" Padding="12">
                    <StackPanel>
                        <RadioButton x:Name="AllFilterRadio" GroupName="PeriodFilter"
                                     IsChecked="{Binding IsAllFilter}"
                                     Content="Todos" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <RadioButton x:Name="CustomRangeFilterRadio" GroupName="PeriodFilter"
                                         Width="170" VerticalAlignment="Center"
                                         IsChecked="{Binding IsCustomRangeFilter}"
                                         Content="Intervalo personalizado:" />
                            <DatePicker x:Name="StartDatePicker" Width="125"
                                        IsEnabled="{Binding UsesCustomRange}"
                                        SelectedDate="{Binding StartDate}" />
                            <TextBlock Margin="9,0" VerticalAlignment="Center" Text="—" />
                            <DatePicker x:Name="EndDatePicker" Width="125"
                                        IsEnabled="{Binding UsesCustomRange}"
                                        SelectedDate="{Binding EndDate}" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <RadioButton x:Name="LastDaysFilterRadio" GroupName="PeriodFilter"
                                         Width="100" VerticalAlignment="Center"
                                         IsChecked="{Binding IsLastDaysFilter}"
                                         Content="Nos últimos" />
                            <TextBox x:Name="LastDaysTextBox" Width="55"
                                     IsEnabled="{Binding UsesLastDays}"
                                     Text="{Binding LastDaysText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="dias" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Margin="0,10,0,0" Header="Apresentação" Padding="12">
                    <CheckBox x:Name="DeltaCheckBox"
                              IsChecked="{Binding IncludeDelta}"
                              Content="Exibir variação (delta) entre resultados" />
                </GroupBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="2,0,0,6" Foreground="#A4262C"
                       Text="{Binding ValidationMessage}" />
            <TextBox x:Name="CurvesOutputBox" Grid.Row="1" Padding="12"
                     Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Click="Generate_Click" Content="Gerar curvas" />
            <Button Margin="0,0,8,0" Click="Copy_Click" Content="Copiar texto" />
            <Button Margin="0" IsDefault="True" Click="Close_Click" Content="Fechar" />
        </StackPanel>
    </Grid>
</Window>
